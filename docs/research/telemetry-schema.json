{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Agent Research Telemetry",
  "type": "object",
  "required": [
    "session_id",
    "scenario",
    "surface",
    "started_at",
    "completed_at",
    "metrics"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "scenario": {
      "type": "string",
      "enum": [
        "multi_file_bug_fix",
        "constrained_refactor",
        "greenfield_feature",
        "pr_review_parallel_concerns",
        "local_to_cloud_resume",
        "external_context_task"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "baseline",
        "prototype"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "object",
      "required": [
        "autonomous_completion",
        "human_interruptions",
        "verification_before_apply",
        "wrong_context_errors",
        "approval_prompts",
        "dangerous_access_used",
        "user_trust_score"
      ],
      "properties": {
        "autonomous_completion": {
          "type": "boolean"
        },
        "human_interruptions": {
          "type": "integer",
          "minimum": 0
        },
        "verification_before_apply": {
          "type": "boolean"
        },
        "wrong_context_errors": {
          "type": "integer",
          "minimum": 0
        },
        "approval_prompts": {
          "type": "integer",
          "minimum": 0
        },
        "dangerous_access_used": {
          "type": "boolean"
        },
        "user_trust_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "subagent_count": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
